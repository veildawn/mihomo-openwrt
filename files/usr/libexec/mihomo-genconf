#!/usr/bin/ucode
/*
 * mihomo-genconf: render /etc/mihomo/config.yaml from template.yaml and a
 * subscription profile in /etc/config/mihomo.
 *
 *   mihomo-genconf [-p <profile>] [-t <template>] [-o <output>]
 *
 * Without -p the active profile (mihomo.main.active) is used.
 * Exit codes: 0 ok, 2 no usable profile, 3 template unreadable, 4 write failed.
 */

'use strict';

import { readfile, writefile, rename, chmod } from 'fs';
import { cursor } from 'uci';

const DIR = '/etc/mihomo';

let profile = null;
let template = DIR + '/template.yaml';
let output = DIR + '/config.yaml';

for (let i = 0; i < length(ARGV); i++) {
	if (ARGV[i] == '-p') profile = ARGV[++i];
	else if (ARGV[i] == '-t') template = ARGV[++i];
	else if (ARGV[i] == '-o') output = ARGV[++i];
}

function die(code, msg) {
	warn(msg + '\n');
	exit(code);
}

/* values land inside YAML double quotes */
function yq(s) {
	return replace(replace(s ?? '', '\\', '\\\\'), '"', '\\"');
}

const c = cursor();
profile ??= c.get('mihomo', 'main', 'active');

if (!profile || c.get('mihomo', profile) != 'profile')
	die(2, 'no active subscription profile');

const url = c.get('mihomo', profile, 'url');
if (!url || !match(url, /^https?:\/\/[^[:space:]"]+$/))
	die(2, `profile ${profile} has no valid url`);

let interval = int(c.get('mihomo', profile, 'interval') ?? 3600);
if (!(interval >= 300))
	interval = 3600;

const tpl = readfile(template);
if (tpl == null)
	die(3, `cannot read ${template}`);

const vars = {
	__SUBSCRIPTION_URL__: yq(url),
	__SUBSCRIPTION_INTERVAL__: `${interval}`,
	__PROFILE_ID__: profile,
	__USER_AGENT__: yq(c.get('mihomo', profile, 'user_agent') || 'clash-verge/v2.4.2'),
	__MIHOMO_SECRET__: yq(c.get('mihomo', 'main', 'secret') ?? '')
};

let out = '# generated by mihomo-genconf from ' + template + ' - edit the template instead\n' + tpl;
for (let k, v in vars)
	out = replace(out, k, v);

if (!writefile(output + '.tmp', out))
	die(4, `cannot write ${output}.tmp`);

chmod(output + '.tmp', 0o600);

if (!rename(output + '.tmp', output))
	die(4, `cannot write ${output}`);

exit(0);
