#!/bin/sh
# First boot: firewall zone for the TUN device, a per-device API secret, and
# migration of a hand-written single-subscription config.yaml into a profile.

if ! uci -q get firewall.mihomo >/dev/null; then
	uci set firewall.mihomo=zone
	uci set firewall.mihomo.name='mihomo'
	uci set firewall.mihomo.device='Meta'
	uci set firewall.mihomo.input='ACCEPT'
	uci set firewall.mihomo.output='ACCEPT'
	uci set firewall.mihomo.forward='ACCEPT'
	uci set firewall.mihomo.mtu_fix='1'
	uci set firewall.lan_mihomo=forwarding
	uci set firewall.lan_mihomo.src='lan'
	uci set firewall.lan_mihomo.dest='mihomo'
	uci commit firewall
fi

uci -q get mihomo.main >/dev/null || uci set mihomo.main=mihomo

old=/etc/mihomo/config.yaml

# Upgrading from a config.yaml that carried its own subscription (kept by
# sysupgrade): turn it into the first profile and keep its API secret so
# external dashboards keep working.
if [ -f "$old" ] && ! grep -q '^# generated by mihomo-genconf' "$old" &&
   [ -z "$(uci -q show mihomo | grep '=profile$')" ]; then
	url=$(awk '/^proxy-providers:/ { p = 1; next }
	           p && /^[^ #]/ { exit }
	           p && /^ +url:/ { sub(/^ +url: */, ""); gsub(/"/, ""); print; exit }' "$old")
	ua=$(awk '/^proxy-providers:/ { p = 1; next }
	          p && /^[^ #]/ { exit }
	          p && /User-Agent:/ { u = 1; next }
	          u && /^ +- / { sub(/^ +- */, ""); gsub(/"/, ""); print; exit }' "$old")
	case "$url" in
	http://*|https://*)
		sec=$(uci add mihomo profile)
		uci set "mihomo.$sec.name=导入的订阅"
		uci set "mihomo.$sec.url=$url"
		[ -n "$ua" ] && uci set "mihomo.$sec.user_agent=$ua"
		uci set "mihomo.$sec.interval=3600"
		uci set "mihomo.main.active=$sec"
		;;
	esac

	if [ -z "$(uci -q get mihomo.main.secret)" ]; then
		s=$(sed -n 's/^secret: *"\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$old" | head -n1)
		case "$s" in ''|__*__) ;; *) uci set "mihomo.main.secret=$s" ;; esac
	fi
	mv "$old" "$old.pre-profiles"
fi

if [ -z "$(uci -q get mihomo.main.secret)" ]; then
	uci set "mihomo.main.secret=$(hexdump -n 16 -e '16/1 "%02x"' /dev/urandom)"
fi

uci commit mihomo
exit 0
